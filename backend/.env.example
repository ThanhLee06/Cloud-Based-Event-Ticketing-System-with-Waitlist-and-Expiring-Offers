PORT=4000
DATABASE_URL="postgresql://eventflow:eventflow_pass@localhost:5432/eventflow?schema=public"
JWT_SECRET="replace-with-strong-secret-key-min-16-chars"
CORS_ORIGIN="http://localhost:3000"
# ST-002: số lần đăng nhập tối đa mỗi phút trên 1 IP (tăng tạm khi chạy load test 100 người từ 1 máy)
AUTH_LOGIN_RATE_LIMIT=10
# Đặt true khi chạy sau load balancer/proxy trên AWS
TRUST_PROXY=false
# Mật khẩu chung cho 103 tài khoản seed
SEED_PASSWORD="Eventflow@123"
