PORT=4000
DATABASE_URL="postgresql://eventflow:eventflow_pass@localhost:5432/eventflow?schema=public"
JWT_SECRET="replace-with-strong-secret-key-min-16-chars"
CORS_ORIGIN="http://localhost:3000"
# ST-002: số lần đăng nhập tối đa mỗi phút trên 1 IP (tăng tạm khi chạy load test 100 người từ 1 máy)
AUTH_LOGIN_RATE_LIMIT=10
# Đặt true khi chạy sau load balancer/proxy trên AWS
TRUST_PROXY=false
# Mật khẩu chung cho 100 student + 2 organizer khi seed
SEED_PASSWORD="Eventflow@123"
# Mật khẩu riêng cho admin@eventflow.vn (để trống = dùng SEED_PASSWORD). Khi deploy PHẢI đặt mật khẩu mạnh.
SEED_ADMIN_PASSWORD=""

# ===== Email (OTP xác thực đăng ký) =====
# console = in mã OTP ra terminal backend (không cần cấu hình gì) | smtp = gửi email thật
MAIL_DRIVER=console
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<địa chỉ gmail>,
# SMTP_PASS=<App Password 16 ký tự, viết liền không dấu cách>. KHÔNG commit mật khẩu thật.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Tên người gửi hiển thị, vd: "EventFlow <ten.ban@gmail.com>" (để trống = EventFlow <SMTP_USER>)
MAIL_FROM=""
